# Environment Variables
# Copy this file to .env.local and fill in values if needed.
# This static site currently requires no environment variables.

# ─── Optional: Analytics ────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Optional: Contact Form Backend ─────────────────────────
# CONTACT_FORM_ENDPOINT=https://your-api.com/contact

# ─── Optional: Site URL (used in sitemap / OG tags) ─────────
# NEXT_PUBLIC_SITE_URL=https://moonstarhotel.com
